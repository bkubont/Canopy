# Copy to .env.local for local development. Never commit real secrets.

# MySQL connection string (Hostinger Node.js apps: use 127.0.0.1, not localhost)
# Example local: mysql://canopy:canopy@127.0.0.1:3306/canopy
# Hostinger sets DATABASE_URL automatically via hosting_databases_setup-website
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"

# Random 32+ character secret used to sign session cookies
SESSION_SECRET="replace-with-a-long-random-string"

# Cookie Secure flag (true in production HTTPS; false for local http://localhost)
SESSION_SECURE="true"

# Optional seed (npm run db:seed) — owner login for first boot
SEED_BUSINESS_NAME="Canopy Tree Service"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-on-first-login"
SEED_OWNER_NAME="Owner"
